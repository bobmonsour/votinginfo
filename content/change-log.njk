---
layout: layouts/base.njk
title: "Change Log"
description: "See a log of recent changes to the voting requirements data for each state."
---

<div class="about-content">
	<a href="/" class="back-btn">&larr; Back to the States</a>
	<h1>Change Log <span class="heading-subtitle">Site feature changes can be found <a href="/about/#site-changes">here</a>.</span></h1>

	{% set hasChanges = false %}
	{%- for state in states %}
		{%- if state.changes.length %}
			{% set hasChanges = true %}
		{%- endif %}
	{%- endfor %}

	{% if hasChanges %}
	<div class="changes-controls">
		<button class="filter-btn" aria-pressed="true" data-sort="state">By State</button>
		<button class="filter-btn" aria-pressed="false" data-sort="date">By Date</button>
	</div>

	<div id="changes-by-state">
		{%- for state in states %}
			{%- if state.changes.length %}
			<section>
				<h2><a href="/states/{{ state.state | slug }}/">{{ state.state }}</a></h2>
				<ul class="change-list">
					{%- for change in state.changes | reverse %}
					<li data-date="{{ change.date }}" data-state="{{ state.state }}" data-abbr="{{ state.abbreviation | lower }}" data-slug="{{ state.state | slug }}" data-field="{{ change.field }}" data-desc="{{ change.description }}">
						<time datetime="{{ change.date }}">{{ change.date | formatDate }}</time>
						{% if change.field %}<code>{{ change.field }}</code>{% endif %}
						<span>{{ change.description }}{% if change.field == "Recent News" %} (<a href="/states/{{ state.state | slug }}/#recent-news">view</a>){% endif %}</span>
					</li>
					{%- endfor %}
				</ul>
			</section>
			{%- endif %}
		{%- endfor %}
	</div>

	<div id="changes-by-date" hidden></div>

	<script>
	(function() {
		var btns = document.querySelectorAll('.changes-controls .filter-btn');
		var byState = document.getElementById('changes-by-state');
		var byDate = document.getElementById('changes-by-date');
		var built = false;

		var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
		function fmtDate(str) {
			var p = str.split('-');
			return months[parseInt(p[1],10)-1] + ' ' + parseInt(p[2],10) + ', ' + p[0];
		}

		function buildByDate() {
			var items = byState.querySelectorAll('li[data-date]');
			var dateMap = {};
			items.forEach(function(li) {
				var d = li.dataset.date;
				if (!dateMap[d]) dateMap[d] = [];
				dateMap[d].push({
					state: li.dataset.state,
					slug: li.dataset.slug,
					field: li.dataset.field,
					desc: li.dataset.desc
				});
			});
			var dates = Object.keys(dateMap).sort().reverse();
			var html = '';
			dates.forEach(function(date) {
				html += '<details class="date-group"><summary>' + fmtDate(date) + '</summary><ul class="change-list">';
				dateMap[date].forEach(function(entry) {
					html += '<li>';
					html += '<a href="/states/' + entry.slug + '/" class="change-state-link">' + entry.state + '</a>';
					if (entry.field) html += '<code>' + entry.field + '</code>';
					var descHtml = entry.desc;
				if (entry.field === 'Recent News') descHtml += ' (<a href="/states/' + entry.slug + '/#recent-news">view</a>)';
				html += '<span>' + descHtml + '</span>';
					html += '</li>';
				});
				html += '</ul></details>';
			});
			byDate.innerHTML = html;

			// Accordion: only one date open at a time
			byDate.querySelectorAll('.date-group').forEach(function(det) {
				det.addEventListener('toggle', function() {
					if (det.open) {
						byDate.querySelectorAll('.date-group').forEach(function(other) {
							if (other !== det) other.removeAttribute('open');
						});
					}
				});
			});

			built = true;
		}

		btns.forEach(function(btn) {
			btn.addEventListener('click', function() {
				var sort = btn.dataset.sort;
				btns.forEach(function(b) { b.setAttribute('aria-pressed', 'false'); });
				btn.setAttribute('aria-pressed', 'true');
				if (sort === 'date' && !built) buildByDate();
				byState.hidden = sort !== 'state';
				byDate.hidden = sort !== 'date';
			});
		});
	})();
	</script>

	{% else %}
		<section>
			<p>No changes have been recorded yet. As state data is researched and updated, changes will be logged here.</p>
		</section>
	{% endif %}
</div>
