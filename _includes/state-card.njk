<div class="state-card" data-state="{{ state.state | lower }}" data-abbr="{{ state.abbreviation | lower }}" data-same-day="{{ state.sameDayRegistration }}" data-online="{{ state.registrationMethods.online }}" data-early="{{ state.earlyVoting.available }}" data-no-excuse="{{ state.mailInVoting.noExcuseRequired }}" data-excuse-required="{{ state.mailInVoting.available and not state.mailInVoting.noExcuseRequired }}">
	<div class="card-header">
		<h2 class="card-title">
			{% if state.abbreviation == "DC" %}
			<img class="state-flag" src="/img/flags/dc.svg" alt="{{ state.state }} flag" loading="lazy" width="36" height="24">
			{% else %}
			<img class="state-flag" src="https://flagcdn.com/w40/us-{{ state.abbreviation | lower }}.png" alt="{{ state.state }} flag" loading="lazy" width="40" height="24">
			{% endif %}
			<a href="/states/{{ state.state | slug }}/">{{ state.state }}</a>
			<span class="card-abbr">{{ state.abbreviation }}</span>
		</h2>
	</div>
	<dl class="card-key-facts">
		<dt>Registration Deadline</dt>
		<dd>{{ state.registrationDeadline }}</dd>
		<dt>Same-Day Registration</dt>
		<dd>{{ "Yes" if state.sameDayRegistration else "No" }}</dd>
		<dt>Online Registration</dt>
		<dd>{{ "Yes" if state.registrationMethods.online else "No" }}</dd>
		<dt>Early Voting</dt>
		<dd>{{ "Yes" if state.earlyVoting.available else "No" }}</dd>
		<dt>Mail-In Voting</dt>
		<dd>{% if state.mailInVoting.noExcuseRequired %}No excuse required{% elif state.mailInVoting.available %}Excuse required{% else %}No{% endif %}</dd>
	</dl>
	<div class="card-details">
		<dl>
			<dt>ID to Vote</dt>
			<dd>{{ state.idRequirements.toVote }}</dd>
			<dt>Early Voting Details</dt>
			<dd>{{ state.earlyVoting.details }}</dd>
			<dt>Mail-In Voting Details</dt>
			<dd>{{ state.mailInVoting.details }}</dd>
		</dl>
	</div>
	<div class="card-external-links">
		<a href="{{ state.officialUrl }}" class="card-external-link" target="_blank" rel="noopener noreferrer">Official Election Website &rarr;</a>
		<a href="https://www.vote.org/state/{{ state.state | slug }}/" class="card-external-link" target="_blank" rel="noopener noreferrer">Tools at Vote.org: {{ state.abbreviation }} &rarr;</a>
	</div>
	<a href="/states/{{ state.state | slug }}/" class="card-full-link">Full details &rarr;</a>
</div>
