<article class="state-card" id="states-{{ state.abbreviation | lower }}"
	data-state="{{ state.state | lower }}"
	data-abbr="{{ state.abbreviation | lower }}"
	data-same-day="{{ state.sameDayRegistration }}"
	data-online="{{ state.registrationMethods.online }}"
	data-early="{{ state.earlyVoting.available }}"
	data-no-excuse="{{ state.mailInVoting.noExcuseRequired }}"
	data-excuse-required="{{ state.mailInVoting.available and not state.mailInVoting.noExcuseRequired }}">
	<div class="card-head">
		{% if state.abbreviation == "DC" %}
		<img class="flag" src="/img/flags/dc.svg" alt="{{ state.state }} flag" loading="lazy" width="36" height="24">
		{% else %}
		<img class="flag" src="https://flagcdn.com/w40/us-{{ state.abbreviation | lower }}.png" alt="{{ state.state }} flag" loading="lazy" width="36" height="24">
		{% endif %}
		<div class="title-stack">
			<h3><a href="/states/{{ state.state | slug }}/">{{ state.state }}</a></h3>
			<span class="abbr">{{ state.abbreviation }}</span>
		</div>
	</div>

	<div class="badges">
		<span class="badge {{ 'yes' if state.sameDayRegistration else 'no' }}"><span class="glyph">{{ '✓' if state.sameDayRegistration else '✕' }}</span> Same-day</span>
		<span class="badge {{ 'yes' if state.registrationMethods.online else 'no' }}"><span class="glyph">{{ '✓' if state.registrationMethods.online else '✕' }}</span> Online</span>
		<span class="badge {{ 'yes' if state.earlyVoting.available else 'no' }}"><span class="glyph">{{ '✓' if state.earlyVoting.available else '✕' }}</span> Early</span>
		{% if state.mailInVoting.noExcuseRequired %}
		<span class="badge yes"><span class="glyph">✓</span> No-excuse mail-in</span>
		{% elif state.mailInVoting.available %}
		<span class="badge warn"><span class="glyph">✓</span> Excuse req. mail-in</span>
		{% else %}
		<span class="badge no"><span class="glyph">✕</span> No mail-in</span>
		{% endif %}
	</div>

	<div class="deadline">
		<span class="label">Registration Deadline</span>
		<span class="value">{{ state.registrationDeadline }}</span>
	</div>

	<dl>
		<div>
			<dt>ID to vote</dt>
			<dd>{{ state.idRequirements.toVote }}</dd>
		</div>
		<div>
			<dt>Early voting</dt>
			<dd>{{ state.earlyVoting.details }}</dd>
		</div>
		<div>
			<dt>Mail-in voting</dt>
			<dd>{{ state.mailInVoting.details }}</dd>
		</div>
	</dl>

	<div class="footer">
		<a href="/states/{{ state.state | slug }}/">Details<span class="arrow">→</span></a>
		<a href="/states/{{ state.state | slug }}/#recent-news">News<span class="arrow">→</span></a>
	</div>
</article>
