<li>
	<a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
	<span class="news-meta"><a href="/states/{{ item.stateSlug }}/all-news/">{{ item.stateAbbr }}</a> · {{ item.source }} · <time datetime="{{ item.date }}">{{ item.date | formatDate }}</time></span>
	<p>{{ item.summary }}</p>
</li>
