---
layout: layouts/base.njk
---
<article class="state-detail">
	<div class="state-detail-header">
		<a href="/states/{{ state.state | slug }}/" class="back-btn" aria-label="Back to {{ state.state }} details">&larr; Back to {{ state.state }}</a>
		<h1>All News &mdash; {{ state.state }} <a href="/state-news/{{ state.abbreviation | lower }}/feed.xml" class="rss-icon" title="RSS feed for {{ state.state }} news" aria-label="RSS feed"><img src="/img/rss-icon.svg" alt="RSS" width="28" height="28"></a></h1>
	</div>

	{% set allItems = [] %}
	{% set seenTitles = [] %}
	{% for run in stateNews.runs | reverse %}
		{% set items = run.states[state.abbreviation] if run.states[state.abbreviation] else [] %}
		{% for item in items %}
			{% if item.title not in seenTitles %}
				{% set seenTitles = (seenTitles.push(item.title), seenTitles) %}
				{% set allItems = (allItems.push(item), allItems) %}
			{% endif %}
		{% endfor %}
	{% endfor %}

	{% if allItems.length %}
	<ul class="news-list">
		{%- for item in allItems | sort(true, false, "date") %}
		<li>
			<a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
			<span class="news-meta">{{ item.source }} · {{ item.date | formatDate }}</span>
			<p>{{ item.summary }}</p>
		</li>
		{%- endfor %}
	</ul>
	{% else %}
	<p>No news items have been captured for {{ state.state }} yet.</p>
	{% endif %}
</article>
