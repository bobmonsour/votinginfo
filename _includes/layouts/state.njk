---
layout: layouts/base.njk
---
<article class="state-detail">
	<div class="state-detail-header">
		<a href="/" class="back-btn" aria-label="Back to all states">&larr; All States</a>
		<h1>
			{% if state.abbreviation == "DC" %}
			<img class="state-flag state-flag-lg" src="/img/flags/dc.svg" alt="{{ state.state }} flag" loading="lazy" width="60" height="40">
			{% else %}
			<img class="state-flag state-flag-lg" src="https://flagcdn.com/w80/us-{{ state.abbreviation | lower }}.png" alt="{{ state.state }} flag" loading="lazy" width="80" height="40">
			{% endif %}
			{{ state.state }} <span class="state-abbr">({{ state.abbreviation }})</span>
		</h1>
	</div>

	<div class="state-detail-grid">
		<aside class="state-sidebar">
			<h2>Key Facts</h2>
			<dl class="key-facts">
				<dt>
					Registration Deadline
					<button class="info-btn" aria-label="Definition of Registration Deadline" aria-expanded="false">ⓘ</button>
					<div class="info-popover" role="tooltip">{{ glossary["Registration Deadline"].definition }}</div>
				</dt>
				<dd>{{ state.registrationDeadline }}</dd>
				<dt>
					Same-Day Registration
					<button class="info-btn" aria-label="Definition of Same-Day Registration" aria-expanded="false">ⓘ</button>
					<div class="info-popover" role="tooltip">{{ glossary["Same-Day Registration"].definition }}</div>
				</dt>
				<dd>{{ "Yes" if state.sameDayRegistration else "No" }}</dd>
				<dt>
					Online Registration
					<button class="info-btn" aria-label="Definition of Online Registration" aria-expanded="false">ⓘ</button>
					<div class="info-popover" role="tooltip">{{ glossary["Online Registration"].definition }}</div>
				</dt>
				<dd>{{ "Yes" if state.registrationMethods.online else "No" }}</dd>
				<dt>
					Early Voting
					<button class="info-btn" aria-label="Definition of Early Voting" aria-expanded="false">ⓘ</button>
					<div class="info-popover" role="tooltip">{{ glossary["Early Voting"].definition }}</div>
				</dt>
				<dd>{{ "Yes" if state.earlyVoting.available else "No" }}</dd>
				<dt>
					Mail-In Voting
					<button class="info-btn" aria-label="Definition of Mail-In Voting" aria-expanded="false">ⓘ</button>
					<div class="info-popover" role="tooltip">{{ glossary["Mail-In Voting"].definition }}</div>
				</dt>
				<dd>{% if state.mailInVoting.noExcuseRequired %}No excuse required{% elif state.mailInVoting.available %}Excuse required{% else %}No{% endif %}</dd>
			</dl>
			<div class="state-badges">
				<span class="badge {{ 'badge-yes' if state.sameDayRegistration else 'badge-no' }}">
					{{ "✓" if state.sameDayRegistration else "✗" }} Same-Day Reg
				</span>
				<span class="badge {{ 'badge-yes' if state.registrationMethods.online else 'badge-no' }}">
					{{ "✓" if state.registrationMethods.online else "✗" }} Online Reg
				</span>
				<span class="badge {{ 'badge-yes' if state.earlyVoting.available else 'badge-no' }}">
					{{ "✓" if state.earlyVoting.available else "✗" }} Early Voting
				</span>
				{% if state.mailInVoting.noExcuseRequired %}
				<span class="badge badge-yes">✓ No-Excuse Mail-In</span>
				{% elif state.mailInVoting.available %}
				<span class="badge badge-no">✗ Excuse Required Mail-In</span>
				{% else %}
				<span class="badge badge-no">✗ Mail-In</span>
				{% endif %}
			</div>
			<a href="{{ state.officialUrl }}" class="official-link" target="_blank" rel="noopener noreferrer">Official Election Website &rarr;</a>
		</aside>

		<div class="state-main">
			<section>
				<h2>Eligibility</h2>
				<p><strong>Age:</strong> {{ state.eligibilityAge }}</p>
			</section>

			<section>
				<h2>ID Requirements</h2>
				<p><strong>To Register:</strong> {{ state.idRequirements.toRegister }}</p>
				<p><strong>To Vote:</strong> {{ state.idRequirements.toVote }}</p>
			</section>

			<section>
				<h2>Registration Methods</h2>
				<ul class="method-list">
					<li class="{{ 'available' if state.registrationMethods.online else 'unavailable' }}"><strong>Online:</strong> {{ glossary["Online Registration"].available if state.registrationMethods.online else glossary["Online Registration"].unavailable }}</li>
					<li class="{{ 'available' if state.registrationMethods.mail else 'unavailable' }}"><strong>Mail:</strong> {{ glossary["Mail Registration"].available if state.registrationMethods.mail else glossary["Mail Registration"].unavailable }}</li>
					<li class="{{ 'available' if state.registrationMethods.inPerson else 'unavailable' }}"><strong>In Person:</strong> {{ glossary["In-Person Registration"].available if state.registrationMethods.inPerson else glossary["In-Person Registration"].unavailable }}</li>
				</ul>
			</section>

			<section>
				<h2>
					Early Voting
					<button class="info-btn" aria-label="Definition of Early Voting" aria-expanded="false">ⓘ</button>
					<div class="info-popover" role="tooltip">{{ glossary["Early Voting"].definition }}</div>
				</h2>
				<p>{{ state.earlyVoting.details }}</p>
			</section>

			<section>
				<h2>
					Mail-In / Absentee Voting
					<button class="info-btn" aria-label="Definition of Mail-In Voting" aria-expanded="false">ⓘ</button>
					<div class="info-popover" role="tooltip">{{ glossary["Mail-In Voting"].definition }}</div>
				</h2>
				<p>{{ state.mailInVoting.details }}</p>
			</section>

			<section>
				<h2>
					Felony Voting Rules
					<button class="info-btn" aria-label="Definition of Felony Voting Rules" aria-expanded="false">ⓘ</button>
					<div class="info-popover" role="tooltip">{{ glossary["Felony Voting Rules"].definition }}</div>
				</h2>
				<p>{{ state.felonyVotingRules }}</p>
			</section>

			<section>
				<h2>Documentation Needed</h2>
				<ul>
					{%- for doc in state.documentationNeeded %}
					<li>{{ doc }}</li>
					{%- endfor %}
				</ul>
			</section>

			{% if state.notes %}
			<section>
				<h2>Additional Notes</h2>
				<p>{{ state.notes }}</p>
			</section>
			{% endif %}

			{% set latestRun = stateNews.runs | last %}
			{% set news = latestRun.states[state.abbreviation] if latestRun else [] %}
			{% if news and news.length %}
			<section class="recent-news" id="recent-news">
				<h2>Recent News</h2>
				<ul class="news-list">
					{%- for item in news | sort(true, false, "date") %}
					{% if loop.index <= 4 %}
					<li>
						<a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
						<span class="news-meta">{{ item.source }} · {{ item.date | formatDate }}</span>
						<p>{{ item.summary }}</p>
					</li>
					{% endif %}
					{%- endfor %}
				</ul>
				<a href="/states/{{ state.abbreviation | lower }}/all-news/" class="back-btn">View all news &rarr;</a>
			</section>
			{% endif %}

			<section>
				<h2>Sources</h2>
				<ul>
					{%- for source in state.sources %}
					<li><a href="{{ source.url }}" target="_blank" rel="noopener">{{ source.name }}</a></li>
					{%- endfor %}
				</ul>
			</section>

			{% if state.recentLegislation.length %}
			<section class="legislation">
				<h2>Recent Legislation</h2>
				<ul class="legislation-list">
					{%- for item in state.recentLegislation %}
					{% if item.active %}
					<li>
						<strong>{{ item.bill }} ({{ item.year }})</strong>
						<span>{{ item.description }}</span>
						<span class="legislation-status">{{ item.status }}</span>
					</li>
					{% endif %}
					{%- endfor %}
				</ul>
			</section>
			{% endif %}

			{% if state.pendingLegislation.length %}
			<section class="legislation legislation-pending">
				<h2>Pending Legislation</h2>
				<ul class="legislation-list">
					{%- for item in state.pendingLegislation %}
					{% if item.active %}
					<li>
						<strong>{{ item.bill }} ({{ item.year }})</strong>
						<span>{{ item.description }}</span>
						<span class="legislation-status">{{ item.status }}</span>
					</li>
					{% endif %}
					{%- endfor %}
				</ul>
			</section>
			{% endif %}

		</div>
	</div>

	<p class="last-verified">Last verified: {{ state.lastVerified | formatDate }}</p>

	{% if state.changes.length %}
	<section class="change-log">
		<h2>Change Log</h2>
		<ul class="change-list">
			{%- for change in state.changes | reverse %}
			<li>
				<time datetime="{{ change.date }}">{{ change.date | formatDate }}</time>
				{% if change.field %}<code>{{ change.field }}</code>{% endif %}
				<span>{{ change.description }}</span>
			</li>
			{%- endfor %}
		</ul>
	</section>
	{% endif %}
</article>
