<!doctype html>
<html lang="{{ metadata.language or 'en' }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title or metadata.title }}</title>
	<meta name="description" content="{{ description }}">
  <meta property="og:image" content="https://usvoting.info/img/og-image.png">
  <meta name="generator" content="{{ eleventy.generator }}">
	<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&display=swap">
	<link rel="stylesheet" href="/css/style.css">
  <!-- Fathom - beautiful, simple website analytics -->
  <script src="https://cdn.usefathom.com/script.js" data-site="OFSUUUEW" defer></script>
  <!-- / Fathom -->
</head>
<body>
	<a class="skip-link" href="#main-content">Skip to main content</a>
	<header class="site-header">
		<div class="container">
			<a href="/" class="site-title">US Voting Info<span class="dot">.</span></a>
			<button class="nav-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Menu">
				<span class="nav-toggle-icon"></span>
			</button>
			<nav id="main-nav" class="site-nav" aria-label="Main navigation">
				<a href="/">Home</a>
				<a href="/all-news/">News</a>
				<a href="/glossary/">Glossary</a>
				<a href="/change-log/">Change Log</a>
				<a href="/about/">About</a>
			</nav>
			<script>
			(function(){
				var btn=document.querySelector('.nav-toggle');
				var nav=document.getElementById('main-nav');
				btn.addEventListener('click',function(){
					var open=nav.classList.toggle('nav-open');
					btn.setAttribute('aria-expanded',open);
				});
				nav.addEventListener('click',function(e){
					if(e.target.tagName==='A'){
						nav.classList.remove('nav-open');
						btn.setAttribute('aria-expanded','false');
					}
				});
			})();
			</script>
		</div>
	</header>
	{# Site-wide announcement banner — commented out, preserved for future reuse.
	   To re-enable: uncomment this block, update the date and message, and adjust the dismissal storage key if needed.
	<div class="site-banner" role="alert" id="site-banner">
		<div class="container">
			<strong>Note (Feb 25, 2026):</strong> This site is under active development. Verify all details with your state's official election website.
			<button class="banner-dismiss" aria-label="Dismiss notice" onclick="document.getElementById('site-banner').remove();sessionStorage.setItem('bannerDismissed','1')">&times;</button>
		</div>
	</div>
	<script>if(sessionStorage.getItem('bannerDismissed'))document.getElementById('site-banner').remove()</script>
	#}
	<main id="main-content"{% if not fullBleed %} class="container"{% endif %}>
		{{ content | safe }}
	</main>
	<footer class="site-footer">
		<div class="container">
			<div class="colophon">
				<span class="brand">US Voting Info</span>
				An independent reference for voter registration and voting requirements in the 50 states and Washington, D.C. Not affiliated with any state, party, or campaign. Built by <a href="https://bobmonsour.com" target="_blank" rel="noopener">Bob Monsour</a> and <a href="https://claude.com/product/claude-code" target="_blank" rel="noopener">Claude Code</a> with <a href="https://11ty.dev" target="_blank" rel="noopener">Eleventy</a>, hosted on <a href="https://cloudflare.com/" target="_blank" rel="noopener">Cloudflare</a>.
			</div>
			<div>
				<h4>Site</h4>
				<a href="/">Home</a>
				<a href="/all-news/" target="_blank" rel="noopener">All news</a>
				<a href="/glossary/" target="_blank" rel="noopener">Glossary</a>
				<a href="/change-log/" target="_blank" rel="noopener">Change log</a>
				<a href="/about/" target="_blank" rel="noopener">About</a>
			</div>
			<div>
				<h4>Sources</h4>
				<a href="https://www.usa.gov/election-office" target="_blank" rel="noopener">State election offices</a>
				<a href="https://www.ncsl.org/" target="_blank" rel="noopener">NCSL</a>
				<a href="https://www.brennancenter.org/" target="_blank" rel="noopener">Brennan Center</a>
				<a href="https://ballotpedia.org/" target="_blank" rel="noopener">Ballotpedia</a>
			</div>
		</div>
	</footer>
	<script src="/js/filter.js"></script>
	<script src="/js/info-popover.js"></script>
</body>
</html>
