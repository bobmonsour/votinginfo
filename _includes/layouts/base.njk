<!doctype html>
<html lang="{{ metadata.language or 'en' }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title or metadata.title }}</title>
	<meta name="description" content="US Voter Registration and Voting Requirements for all 50 states and Washington DC.">
  <meta property="og:image" content="https://votinginfo.bob-monsour.workers.dev/img/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="generator" content="{{ eleventy.generator }}">
	<link rel="stylesheet" href="/css/style.css">
  <!-- Fathom - beautiful, simple website analytics -->
  <script src="https://cdn.usefathom.com/script.js" data-site="OFSUUUEW" defer></script>
  <!-- / Fathom -->
</head>
<body>
	<a class="skip-link" href="#main-content">Skip to main content</a>
	<header class="site-header">
		<div class="container">
			<a href="/" class="site-title">{{ metadata.title }}</a>
			<nav aria-label="Main navigation">
				<a href="/">Home</a>
				<a href="/glossary/">Glossary</a>
				<a href="/change-log/">Change Log</a>
				<a href="/about/">About</a>
			</nav>
		</div>
	</header>
	<div class="site-banner" role="alert" id="site-banner">
		<div class="container">
			<strong>Note (Feb 25, 2026):</strong> This site is new and data is currently being verified on a state-by-state basis. Please confirm details with your state's official election website before relying on this information.
			<button class="banner-dismiss" aria-label="Dismiss notice" onclick="document.getElementById('site-banner').remove();sessionStorage.setItem('bannerDismissed','1')">&times;</button>
		</div>
	</div>
	<script>if(sessionStorage.getItem('bannerDismissed'))document.getElementById('site-banner').remove()</script>
	<main id="main-content" class="container">
		{{ content | safe }}
	</main>
	<footer class="site-footer">
		<div class="container">
			<p><strong>Disclaimer:</strong> This site is for informational purposes only. Voter registration and voting requirements change frequently. Always verify current requirements with your <a href="https://www.usa.gov/election-office" target="_blank" rel="noopener">state or local election office</a>.</p>
			<p>Data last reviewed: February 2026. Sources include <a href="https://www.ncsl.org/" target="_blank" rel="noopener">NCSL</a>, <a href="https://www.vote.org/" target="_blank" rel="noopener">Vote.org</a>, and official state election websites.</p>

    <p><a href="/about/" target="_blank" rel="noopener">About this site</a> | <a href="/change-log/" target="_blank" rel="noopener">Change Log</a> | Built by <a href="https://bobmonsour.com" target="_blank" rel="noopener">Bob Monsour</a> and <a href="https://claude.com/product/claude-code" target="_blank" rel="noopener">Claude Code</a> with <a href="https://11ty.dev" target="_blank" rel="noopener">Eleventy</a> and hosted on <a href="https://cloudflare.com/" target="_blank" rel="noopener">Cloudflare</a>.</p>
		</div>
	</footer>
	<script src="/js/filter.js"></script>
</body>
</html>
